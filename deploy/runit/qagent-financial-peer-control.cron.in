# Independent forward evaluation window; same persistent state and bundles.
37 11 * * 1-5 @SERVICE_USER@ QAGENT_HOME=@QAGENT_HOME@ PYTHONPATH=@APP_DIR@/backend @APP_DIR@/backend/.venv/bin/python -B @FORWARD_BUNDLE@/scripts/run_financial_forward_research.py --daily-dir @QAGENT_HOME@/research-data/daily-financial --baseline-dir @QAGENT_HOME@/research-data/g2-forward-results/signals --signal-dir @QAGENT_HOME@/research-data/financial-forward-signals --evaluation-dir @QAGENT_HOME@/research-data/financial-forward-evaluations --run-dir @QAGENT_HOME@/research-data/financial-forward-runs --db @STATE_DIR@/qagent.db --provider-mode free --budget-seconds 300 --daily-baseline-source-dir @QAGENT_HOME@/research-data/g2-forward-sources --daily-baseline-frozen-dir @QAGENT_HOME@/research-data/g2-frozen-v1 --daily-baseline-rank-dir @QAGENT_HOME@/research-data/financial-daily-ranks
