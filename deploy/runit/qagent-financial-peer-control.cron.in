# Rehydrated disabled after image restart; operators explicitly decide when to enable.
# Host timezone UTC. Daily bounded window: 16:40-22:40 Asia/Shanghai.
SHELL=/bin/sh
PATH=/usr/bin:/bin
40 8 * * 1-5 @SERVICE_USER@ QAGENT_HOME=@QAGENT_HOME@ @APP_DIR@/backend/.venv/bin/python -B @DAILY_BUNDLE@/scripts/run_daily_financial_v5.py
