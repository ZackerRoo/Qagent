#!/usr/bin/env bash
set -euo pipefail

exec chpst -u @SERVICE_USER@:@SERVICE_USER@ \
  env -i HOME=@SERVICE_HOME@ TZ=Asia/Shanghai PYTHONUNBUFFERED=1 PATH=/usr/bin:/bin \
  /bin/bash -c '
    set -euo pipefail
    set -a
    # The service user, never root, evaluates the application environment.
    source @ENV_FILE@
    set +a
    cd @APP_DIR@/backend
    exec >>@LOG_DIR@/backend.log 2>&1
    exec @APP_DIR@/backend/.venv/bin/python -m uvicorn qagent.app:create_app \
      --factory --host 127.0.0.1 --port 8000
  '
